<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions targetNamespace="http://biblioteca.ifrn.edu.br" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:sch="http://biblioteca.ifrn.edu.br" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://biblioteca.ifrn.edu.br">
  <wsdl:types>
    <xs:schema elementFormDefault="qualified" targetNamespace="http://biblioteca.ifrn.edu.br" xmlns:xs="http://www.w3.org/2001/XMLSchema">
      <xs:complexType name="LivroType">
        <xs:sequence>
          <xs:element name="id" type="xs:string"/>
          <xs:element name="titulo" type="xs:string"/>
          <xs:element name="autor" type="xs:string"/>
          <xs:element name="dataPublicacao" type="xs:date"/>
          <xs:element name="descricao" type="xs:string"/>
          <xs:element name="quantidadePaginas" type="xs:int"/>
          <xs:element name="quantidadeDisponivel" type="xs:int"/>
          <xs:element name="genero" type="xs:string"/>
          <xs:element name="idioma" type="xs:string"/>
          <xs:element name="editora" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
      <xs:element name="consultarLivroRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="id" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="consultarLivroResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="livro" type="tns:LivroType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!--Não pede nada para listar livros-->
      <xs:element name="listarLivrosRequest">
        <xs:complexType/>
      </xs:element>
      <xs:element name="listarLivrosResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="livro" type="tns:LivroType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="consultarLivroResponse">
    <wsdl:part element="tns:consultarLivroResponse" name="consultarLivroResponse"/>
  </wsdl:message>
  <wsdl:message name="listarLivrosRequest">
    <wsdl:part element="tns:listarLivrosRequest" name="listarLivrosRequest"/>
  </wsdl:message>
  <wsdl:message name="listarLivrosResponse">
    <wsdl:part element="tns:listarLivrosResponse" name="listarLivrosResponse"/>
  </wsdl:message>
  <wsdl:message name="consultarLivroRequest">
    <wsdl:part element="tns:consultarLivroRequest" name="consultarLivroRequest"/>
  </wsdl:message>
  <wsdl:portType name="BibliotecaPort">
    <wsdl:operation name="consultarLivro">
      <wsdl:input message="tns:consultarLivroRequest" name="consultarLivroRequest"/>
      <wsdl:output message="tns:consultarLivroResponse" name="consultarLivroResponse"/>
    </wsdl:operation>
    <wsdl:operation name="listarLivros">
      <wsdl:input message="tns:listarLivrosRequest" name="listarLivrosRequest"/>
      <wsdl:output message="tns:listarLivrosResponse" name="listarLivrosResponse"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="BibliotecaPortSoap11" type="tns:BibliotecaPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="consultarLivro">
      <soap:operation soapAction=""/>
      <wsdl:input name="consultarLivroRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="consultarLivroResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="listarLivros">
      <soap:operation soapAction=""/>
      <wsdl:input name="listarLivrosRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="listarLivrosResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="BibliotecaPortService">
    <wsdl:port binding="tns:BibliotecaPortSoap11" name="BibliotecaPortSoap11">
      <soap:address location="http://localhost:8080/ws"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>