<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://biblioteca.ifrn.edu.br"
    targetNamespace="http://biblioteca.ifrn.edu.br"
    elementFormDefault="qualified">

    <xs:complexType name="LivroType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="titulo" type="xs:string"/>
            <xs:element name="autor" type="xs:string"/>
            <xs:element name="dataPublicacao" type="xs:date"/>
            <xs:element name="descricao" type="xs:string"/>
            <xs:element name="quantidadePaginas" type="xs:int"/>
            <xs:element name="quantidadeDisponivel" type="xs:int"/>
            <xs:element name="genero" type="xs:string"/>
            <xs:element name="idioma" type="xs:string"/>
            <xs:element name="editora" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="consultarLivroRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="consultarLivroResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="livro" type="tns:LivroType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Não pede nada para listar livros -->
    <xs:element name="listarLivrosRequest">
        <xs:complexType/>
    </xs:element>

    <xs:element name="listarLivrosResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element
                    name="livro"
                    type="tns:LivroType"
                    minOccurs="0" 
                    maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
